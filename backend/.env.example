# Azure Table Storage Configuration
# Copy this file to '.env' and fill in your values.

# Your Azure Storage Account name
AZURE_STORAGE_ACCOUNT=your_storage_account_name

# The Table name within the storage account
AZURE_TABLE_NAME=certificates

# Shared Access Signature (SAS) token for the Table
# Must have Read (r) and Query access
# Should start with '?' e.g. ?sv=2021-08-06&ss=t&srt=o&sp=r&se=...&sig=...
AZURE_TABLE_SAS_TOKEN=?sv=2021-08-06&ss=t&srt=o&sp=r&se=2030-01-01T00:00:00Z&sig=EXAMPLE

# (Optional) Allowed CORS origins, comma-separated
# Default: http://localhost:5173,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
